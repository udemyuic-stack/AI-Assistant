{
  "ConnectionStrings": {
    "AiDb": "Host=localhost;Port=5432;Database=ticketsystem;Username=ai_assistant;Password=CHANGE_ME;Search Path=ai"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Ollama": {
    "Host": "http://localhost:11434",
    "ChatModel": "qwen3:8b",
    "ChatContextTokens": 8192,
    "EmbedModel": "qwen3-embedding:8b",
    "TimeoutMinutes": 10
  },

  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6344,
    "Collection": "documents",
    "VectorSize": 4096
  },

  "Storage": {
    "Endpoint": "localhost:9100",
    "Bucket": "ai-assistant-documents",
    "UseSsl": false
  },

  "Rag": {
    "TopK": 15,
    "ContextChunks": 5,
    "SimilarityThreshold": 0.4,
    "Temperature": 0.0,
    "ChunkSize": 1000,
    "ChunkOverlap": 200,
    "RerankEnabled": false
  },

  "Assistant": {
    "SystemPrompt": "Siz — foydalanuvchiga faqat berilgan kontekst (hujjatlar va baza ma'lumotlari) asosida javob beradigan yordamchisiz. Har doim rasmiy o'zbek tilida javob bering, hatto kontekst boshqa tilda bo'lsa ham. Ma'lumot kontekstda bo'lmasa, uni o'ylab topmang — 'Bu haqda ma'lumot topilmadi' deb ayting.",
    "GuestQuestionLimit": 5
  }
}
